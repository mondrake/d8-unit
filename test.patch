+    yield 'valid image 1' => ['core/tests/fixtures/files/image-1.png'];
+    yield 'valid image 2' => ['core/tests/fixtures/files/image-test.png'];
+    yield 'PNG with iCCP profile' => [
+      'core/tests/fixtures/files/image-test-iccp-profile.png',
+    ];
+  }
+
+}
