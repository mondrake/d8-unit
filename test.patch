+/*
+ * test :placeholder
+ */
+SELECT dummy as "dummy?"
+  FROM DUAL
+ WHERE '?' = '?'
+-- AND dummy <> :dummy
+   AND dummy = ?
+SQL,
+      ['baz'],
+    ];
+
+    yield 'Escaped question' => [
+      <<<'SQL'
+SELECT '{"a":null}'::jsonb ?? :key
+SQL,
+      [':key' => 'qux'],
+      <<<'SQL'
+SELECT '{"a":null}'::jsonb ?? ?
+SQL,
+      ['qux'],
+    ];
+  }
+
+}
