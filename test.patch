@@ -0,0 +1,18 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Core\Database\Statement;
+
+/**
+ * Enumeration of the types of possible placeholders in SQL statements.
+ */
+enum PlaceholderType {
+
+  // Placeholders in the named format ':placeholder'.
+  case Named;
+
+  // Placeholders in the positional format '?'.
+  case Positional;
+
+}
diff --git a/core/lib/Drupal/Core/Database/Statement/StatementBase.php b/core/lib/Drupal/Core/Database/Statement/StatementBase.php
index c193c5d3502..a52e7434c85 100644
