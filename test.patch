new file mode 100644
index 00000000000..b7823ebf2c6
--- /dev/null
+++ b/core/lib/Drupal/Core/Database/ConnectionParametersBase.php
@@ -0,0 +1,104 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Core\Database;
+
+/**
+ * Base class for connection parameters objects.
+ */
+abstract class ConnectionParametersBase implements ConnectionParametersInterface, \ArrayAccess {
+
+  public function __construct(
+    public readonly string $driver,
+    public readonly string $namespace,
+    public readonly string $autoload,
+    public readonly string $database,
+    public readonly string $prefix = '',
+    public readonly ?string $module = NULL,
+    #[\SensitiveParameter]
+    public readonly ?string $username = NULL,
+    #[\SensitiveParameter]
+    public readonly ?string $password = NULL,
+    #[\SensitiveParameter]
+    public readonly ?string $host = NULL,
+    #[\SensitiveParameter]
+    public readonly ?int $port = NULL,
+    public readonly array $dependencies = [],
+    public readonly array $init_commands = [],
+  ) {
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function createFromOptionsArray(array $options): static {
+    return new static(...$options);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getParameters(): static|array {
+    return $this;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getConnectionClass(): string {
+    return $this->namespace . '\\Connection';
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function toArray(): array {
+    return get_object_vars($this);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function processOptionsArray(array $options): array {
+    return $options;
+  }
+
+  /**
+   * Prevents the connection parameters from being serialized.
+   *
+   * @throws \LogicException
+   */
+  public function __serialize(): array {
+    throw new \LogicException(get_class($this) . ' is not serializable. This probably means you are serializing an object that has an indirect reference to the database connection parameters. Adjust your code so that is not necessary. Alternatively, look at DependencySerializationTrait as a temporary solution.');
+  }
+
+  /**
+   * This is for BC support only.
+   */
+  public function offsetExists(mixed $offset): bool {
+    return property_exists($this, $offset);
+  }
+
+  /**
+   * This is for BC support only.
+   */
+  public function offsetGet(mixed $offset): mixed {
+    return $this->{$offset};
+  }
+
+  /**
+   * This is for BC support only.
+   */
+  public function offsetSet(mixed $offset, mixed $value): void {
+    $this->{$offset} = $value;
+  }
+
+  /**
+   * This is for BC support only.
+   */
+  public function offsetUnset(mixed $offset): void {
+    $this->{$offset} = NULL;
+  }
+
+}
diff --git a/core/lib/Drupal/Core/Database/ConnectionParametersInterface.php b/core/lib/Drupal/Core/Database/ConnectionParametersInterface.php
new file mode 100644
index 00000000000..21f08d27544
--- /dev/null
+++ b/core/lib/Drupal/Core/Database/ConnectionParametersInterface.php
@@ -0,0 +1,66 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Core\Database;
+
+/**
+ * Interface for a database connection parameters object.
+ */
+interface ConnectionParametersInterface {
+
+  /**
+   * Returns a new instance of connection parameters.
+   *
+   * @param array<string, mixed> $options
+   *   An array of connection options.
+   *
+   * @return static
+   *   A new instance of connection parameters.
+   */
+  public static function createFromOptionsArray(array $options): static;
+
+  /**
+   * Returns the parameters.
+   *
+   * For BC reasons, we may need to return the parameters as an array and
+   * not as an object.
+   *
+   * @return static|array<string, mixed>
+   *   The connection parameters.
+   */
+  public function getParameters(): static|array;
+
+  /**
+   * Returns the PHP class name of the connection.
+   *
+   * @return class-string
+   *   The PHP class name of the connection.
+   */
+  public function getConnectionClass(): string;
+
+  /**
+   * Returns the connection parameters as an associative array.
+   *
+   * @return array<string, mixed>
+   *   The connection parameters as an associative array.
+   */
+  public function toArray(): array;
+
+  /**
+   * Processes an array of connection options for driver specific defaults.
+   *
+   * This is used internally by the database layer, should not be called
+   * otherwise.
+   *
+   * @param array<string, mixed> $options
+   *   An array of connection options.
+   *
+   * @return array<string, mixed>
+   *   The processed options as an associative array.
+   *
+   * @internal
+   */
+  public static function processOptionsArray(array $options): array;
+
+}
