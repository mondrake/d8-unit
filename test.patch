+        1074 => throw new SchemaTableColumnSizeTooLargeException($message, $code, $exception),
+        default => throw new DatabaseExceptionWrapper($message, 0, $exception),
+      },
+      default => throw new DatabaseExceptionWrapper($message, 0, $exception),
+    };
